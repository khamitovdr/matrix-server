# Matrix homeserver
${SUBDOMAIN_MATRIX}.${DOMAIN} {
	reverse_proxy synapse:8008

	# Allow large media uploads
	request_body {
		max_size ${MAX_UPLOAD_SIZE_MB}m
	}
}

# Synapse Admin panel
${SUBDOMAIN_ADMIN}.${DOMAIN} {
	reverse_proxy synapse-admin:8080
}

# Element Web client
${SUBDOMAIN_ELEMENT}.${DOMAIN} {
	reverse_proxy element:80
}

# LiveKit signaling + JWT service
${SUBDOMAIN_LIVEKIT}.${DOMAIN} {
	# JWT token service for Element Call
	handle_path /jwt/* {
		reverse_proxy livekit-jwt:8080
	}

	# LiveKit WebSocket signaling
	handle {
		reverse_proxy livekit:7880
	}
}

# Navidrome, tunnelled from the homeserver by chisel. There is no upstream
# here when the homeserver is off — chisel only opens the :4533 listener
# while a client holds it — so the error handler is the normal path for
# "the music is off", not an exotic one.
${SUBDOMAIN_MUSIC}.${DOMAIN} {
	# The homeserver's sshd, dialled in over the same chisel server that
	# carries Navidrome. Design: D2 in the music repo's
	# docs/superpowers/specs/2026-09-07-homeserver-ssh-tunnel-design.md.
	#
	# This is a naming decision, not a security boundary: chisel
	# authenticates the user and knows nothing about which hostname the
	# request arrived on, so tunnel.<domain> reaches the same server. The
	# path is not a secret and is not treated as one.
	@ssh_tunnel {
		# Both forms: Caddy's `*` glob requires the literal `/` in front of
		# it, so `/__tunnel/*` alone does not match the bare prefix with no
		# trailing slash — that request would fall through this route
		# entirely and reach Navidrome's catch-all below.
		path /__tunnel /__tunnel/*
		header Connection *Upgrade*
		header Upgrade websocket
	}

	# A named matcher, not an inline one: `respond`'s inline matcher form
	# consumes exactly one token, so `respond /__tunnel /__tunnel/* 404`
	# does NOT match two paths — it matches the single path `/__tunnel` and
	# takes the rest of the line as `respond`'s two-arg (body, status) form,
	# silently turning `/__tunnel/*` into the response body and losing the
	# 404 on everything else. A named matcher's `path` directive is the one
	# place multiple values are safe, because it isn't sharing the line with
	# the directive's own arguments.
	@tunnel_prefix path /__tunnel /__tunnel/*

	# `route`, not bare directives: Caddy sorts handlers by matcher
	# specificity unless told otherwise, and this block depends on its own
	# written order. Without it the dial-in path can fall through to
	# Navidrome, whose SPA handler answers 200 with the player's HTML —
	# which looks like a working page rather than a broken tunnel.
	route {
		reverse_proxy @ssh_tunnel chisel:8080

		# Everything else under the prefix, including a plain browser GET.
		# A flat 404 rather than falling through: a scanner should learn
		# nothing, and neither should it get the player.
		respond @tunnel_prefix 404

		reverse_proxy chisel:4533 {
			# Navidrome authenticates a request carrying this header AS that
			# user, with no password, whenever ReverseProxyWhitelist matches
			# the caller — and the tunnel's container IP is exactly what
			# would be whitelisted. The whitelist is unset (D7 of the
			# Navidrome design) and a test asserts it stays unset; stripping
			# here means even setting it later cannot turn a header into an
			# admin login.
			header_up -Remote-User
		}
	}

	handle_errors {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><meta charset=utf-8><title>Offline</title><style>body{font-family:system-ui,sans-serif;margin:20vh auto;max-width:26rem;padding:0 1rem;text-align:center;color:#444;line-height:1.5}h1{font-size:1.3rem;margin:0 0 .5rem}</style><h1>The library is offline</h1><p>The home server is not answering right now. Try again in a bit.</p>` 503
	}
}

# chisel's control channel. Only WebSocket upgrades are forwarded; everything
# else gets a 404 from Caddy and never reaches chisel, so a scanner hitting
# this hostname learns nothing about what is behind it.
${SUBDOMAIN_TUNNEL}.${DOMAIN} {
	# Caddy's header matcher is case-sensitive: this requires exactly
	# `Upgrade: websocket` (lowercase) and `Connection: ...Upgrade...`
	# (capital U), which is what today's chisel client sends. A future
	# client or intermediary sending `Upgrade: WebSocket` falls through
	# to the 404 handle below and the tunnel looks down — read that as
	# "check this matcher" before "check the homeserver."
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}

	handle @websocket {
		reverse_proxy chisel:8080
	}

	handle {
		respond 404
	}
}

# Apex domain: .well-known + redirect to Element
${DOMAIN} {
	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"m.homeserver":{"base_url":"https://${SUBDOMAIN_MATRIX}.${DOMAIN}"},"org.matrix.msc4143.rtc_foci":[{"type":"livekit","livekit_service_url":"https://${SUBDOMAIN_LIVEKIT}.${DOMAIN}/jwt"}]}`
	}

	handle /.well-known/matrix/server {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"m.server":"${SUBDOMAIN_MATRIX}.${DOMAIN}:443"}`
	}

	handle {
		redir https://${SUBDOMAIN_ELEMENT}.${DOMAIN}{uri} permanent
	}
}
